{
  "manifest_version": 3,
  "name": "ITF Tennis Data Crawler",
  "version": "1.0",
  "description": "Chrome extension to crawl data from ITF Tennis website and export to CSV",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://www.itftennis.com/*",
    "https://*.nexdev.net/*",
    "http://localhost:5000/*",
    "https://www.live-tennis.cn/*",
    "https://*.7m.com.cn/*",    
    "https://*.badmintoncn.com/*"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.itftennis.com/*"],
      "js": ["jquery.min.js", "content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
